---
export const prerender = false;

import Card from "@/components/Card.astro";
import SearchFilter from "@/components/SearchFilter.tsx";
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";
import { toTitleCase } from "@/utils/functions";

import {
  getAdventuresList,
  getAuthorsList,
  getDurationList,
  getEditionsList,
  getLevelsList,
  getPartySizeList,
  getThemesList,
} from "@/utils/sanity/functions";
import type {
  Adventure,
  AdventureDuration,
  AdventureFilters,
  AdventureOptions,
  AdventurePartySize,
  AdventureRecommendedLevel,
} from "@/utils/sanity/types";

const getSelectedValues = (name: string) =>
  Astro.url.searchParams
    .getAll(name)
    .map((value) => value.trim())
    .filter(Boolean);

const selectedAuthors = getSelectedValues("author");
const selectedEditions = getSelectedValues("edition");
const selectedThemes = getSelectedValues("theme");
const selectedDuration = Astro.url.searchParams.get("duration")?.trim() ?? "";
const selectedLevels = getSelectedValues("level") as string[];
const selectedPartySizes = getSelectedValues("partySize") as string[];

const filters: AdventureFilters = {
  selectedAuthors,
  selectedEditions,
  selectedThemes,
  selectedDuration: selectedDuration
    ? [selectedDuration as AdventureDuration]
    : [],
  selectedLevels,
  selectedPartySizes,
};

const [authors, editions, themes, duration, levels, partySizes, adventures] =
  await Promise.all([
    getAuthorsList(),
    getEditionsList(),
    getThemesList(),
    getDurationList(),
    getLevelsList(),
    getPartySizeList(),
    getAdventuresList(filters),
  ]);

const options: AdventureOptions = {
  authors,
  editions,
  themes,
  duration,
  levels,
  partySizes,
};
---

<Layout title="Search">
  <SearchFilter client:load filters={filters} options={options} />

  {
    adventures.length === 0 ? (
      <p class="pt-8 pb-4">No results</p>
    ) : (
      <section class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-4 pt-8 pb-4">
        {adventures.map((adventure: Adventure) => (
          <Card
            title={adventure.name}
            icon={adventure.icon}
            text={
              toTitleCase(adventure.duration) +
              " adventure by " +
              adventure.authors?.map((a) => a.name).join(", ")
            }
            tags={adventure.themes ? adventure.themes : undefined}
            button={{
              url: "/adventure/" + adventure.slug.current,
              text: "Explore",
            }}
          />
        ))}
      </section>
    )
  }
</Layout>
