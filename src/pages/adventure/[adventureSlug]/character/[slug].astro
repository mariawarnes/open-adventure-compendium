---
import CardGrid from "@/components/CardGrid.astro";
import SinglePageHeader from "@/components/SinglePageHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { getDomainLabel, toTitleCase } from "@/utils/functions";
import {
  getAdventure,
  getCharacter,
  getResourcesByCharacter,
  urlFor,
} from "@/utils/sanity/functions";
import type { Params } from "astro";

export const prerender = false;

const { adventureSlug, slug } = Astro.params as Params;

if (!adventureSlug) {
  throw new Error("Missing adventure slug");
}

if (!slug) {
  throw new Error("Missing character slug");
}

const adventure = await getAdventure(adventureSlug);
const character = await getCharacter(slug);
const resources = await getResourcesByCharacter(slug);

const resourceTypes = [
  ...new Set(resources.flatMap((resource) => resource.type)),
];

const sections = [
  resourceTypes.map((type) => ({
    id: type,
    list:
      resources
        .filter((resource) => resource.type == type)
        .map((resource) => ({
          ...resource,
          name:
            resource.url || resource.attribution
              ? `${toTitleCase(getDomainLabel(resource.url || resource.attribution)) ?? ""} ${toTitleCase(resource.type)}`.trim()
              : toTitleCase(resource.type),
        })) ?? [],
    title: toTitleCase(type),
    getHref: (item) =>
      item.url ? item.url : item.image ? urlFor(item.image) : "",
    getText: (item) => (item.subject ? item.subject.name : ""),
  })),
][0];
---

<Layout title={character.name || ""}>
  <SinglePageHeader
    breadcrumbs={[
      { url: "/", text: "Home" },
      { url: "/adventure/" + adventure.slug.current, text: adventure.name },
      {
        url: "/adventure/" + adventure.slug.current + "#characters",
        text: "Characters",
      },
    ]}
    title={character.name || ""}
  >
    <Fragment slot="subtitle">
      <p>Character</p>
    </Fragment>
  </SinglePageHeader>

  <div id="content" class="my-2">
    {
      sections.length > 0 &&
        sections.map((section) => (
          <CardGrid
            getHref={section.getHref}
            getText={section.getText}
            title={section.title}
            list={section.list}
            type={section.id}
            btnStyle="primary"
          />
        ))
    }
  </div>
</Layout>
