---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { LuSwords } from "react-icons/lu";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <Analytics />
    <SpeedInsights />

    <!-- Google fonts -->
    <!-- <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;700&family=Inter:wght@500;700;800&family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    /> -->

    <title>{title}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚔️</text></svg>"
    />
  </head>
  <body class="text-base-content bg-base-200">
    <header class="navbar bg-base-100 z-20">
      <div class="container mx-auto">
        <div class="px-4">
          <a class="header__title text-xl flex items-center flex-row" href="/">
            <LuSwords className="text-primary mr-2" />
            <h1 class="font-bold">Open Adventure Compendium</h1></a
          >
        </div>
      </div>
    </header>
    <div class="bg-warning text-warning-content">
      <div class="container mx-auto px-4 py-2 text-sm font-bold">
        Beta: this compendium is still being worked on.
      </div>
    </div>
    <div class="container mx-auto">
      <main>
        <slot />
      </main>
      <footer class="px-4 py-8 text-sm text-base-content/70">
        Built by{" "}
        <a class="link link-hover text-primary" href="https://mariawarnes.dev">
          mariawarnes.dev
        </a>
      </footer>
    </div>
  </body>
</html>
