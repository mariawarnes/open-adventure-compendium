---
import type { SanityIcon as SanityIconValue } from "@/utils/sanity/types";

interface Props {
  icon?: SanityIconValue | null;
  class?: string;
}

const { icon, class: className } = Astro.props as Props;
---

{
  icon?.svg && (
    <span
      class:list={[
        "inline-flex shrink-0 items-center justify-center leading-none",
        "[&_svg]:block [&_svg]:h-[1em] [&_svg]:w-[1em] [&_svg]:fill-current [&_svg]:stroke-current",
        className,
      ]}
      aria-hidden="true"
      set:html={icon.svg}
    />
  )
}
