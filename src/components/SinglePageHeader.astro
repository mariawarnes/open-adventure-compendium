---
import SanityIconRenderer from "@/components/SanityIcon.astro";
import type { SanityIcon } from "@/utils/sanity/types";

interface Link {
  url?: string;
  text: string;
}

interface Props {
  title: string;
  breadcrumbs?: Link[];
  icon?: SanityIcon | null;
}

const { title, breadcrumbs, icon } = Astro.props as Props;
---

<div
  class="flex px-4 py-6 md:py-18 scroll-mt-24 flex-col items-center relative"
>
  {
    breadcrumbs && (
      <>
        <div class="breadcrumbs text-sm opacity-70">
          <ul class="mb-4">
            {breadcrumbs.map((breadcrumb) => (
              <li>
                {breadcrumb.url ? (
                  <a href={breadcrumb.url}>{breadcrumb.text}</a>
                ) : (
                  breadcrumb.text
                )}
              </li>
            ))}
          </ul>
        </div>
      </>
    )
  }

  <SanityIconRenderer
    icon={icon}
    class="pointer-events-none z-10 absolute inset-0 m-auto h-full w-full items-center justify-center opacity-5 text-[400px] md:text-[600px]"
  />
  <h2 class="font-bold text-2xl md:text-4xl">{title}</h2>

  <slot name="subtitle" />
</div>
